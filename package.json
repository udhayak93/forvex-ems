{
  "name": "forvex-ems-monorepo",
  "version": "1.0.0",
  "description": "Forvex EMS - Enterprise Employee & Payroll Management System (Local, GitHub, Render, Vercel)",
  "private": true,
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "seed": "npm run seed --prefix backend"
  },
  "keywords": [
    "ems",
    "payroll",
    "employee-management",
    "react",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "Udhaya",
  "license": "ISC"
}
